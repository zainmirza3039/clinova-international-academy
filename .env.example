# Frontend public configuration only. Never add a database password or service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Leave false until the Clinova schema, policies, spam controls and live persistence are verified.
VITE_ENQUIRIES_ENABLED=false
# Confirm academy ownership before setting. Leave blank in preview to prevent indexing.
VITE_SITE_URL=

# OFF until the learner migration is applied in a non-production database and RLS is verified.
VITE_LEARNER_DATA_ENABLED=false

# OFF until Clinova Auth access, email/redirect configuration and security are approved.
# Only the confirmed Clinova project origin is accepted; never reuse another project.
VITE_AUTH_ENABLED=false
# OFF until the CMS auth contract, trusted app_metadata.clinova_roles claims and security gates are verified.
# Public reads use only published_content; admin actions require matching CMS roles.
VITE_CMS_ENABLED=false
# Enable ONLY after academy identity, domain, catalogue and policies are approved.
# Preview hostnames remain blocked even when this is true.
VITE_INDEXING_ENABLED=false
